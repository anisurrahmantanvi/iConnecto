# Supabase project settings -> API. Use the PUBLISHABLE (anon) key only.
# NEVER put a service-role key here: everything prefixed VITE_ ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: base URL for emoji SVG images (must end with a slash).
# Leave empty to use the default Twemoji CDN. Self-host the assets for offline use.
VITE_EMOJI_BASE_URL=

# Optional: STUN/TURN for calls. JSON array of RTCIceServer objects.
# Example: [{"urls":"stun:stun.l.google.com:19302"}]
VITE_ICE_SERVERS=
